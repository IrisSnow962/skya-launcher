{
  "name": "skya-launcher",
  "productName": "Skya Launcher",
  "version": "1.3.2",
  "description": "A sleek game launcher that finds your Steam and Epic games and launches them in one click.",
  "main": "main.js",
  "author": "Iris Snow",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win && node scripts/embed-metadata.js",
    "dist:mac": "electron-builder --mac",
    "embed-metadata": "node scripts/embed-metadata.js"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.irissnow.skyalauncher",
    "productName": "Skya Launcher",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    }
  }
}
